{
    "global": { "show_in_menu_bar": false },
    "profiles": [
        {
            "complex_modifications": {
                "rules": [
                    {
                        "description": "UA Companion volume knob override",
                        "manipulators": [
                            {
                                "description": "Mute button -> UA Companion mute (or system mute)",
                                "from": { "consumer_key_code": "mute" },
                                "to": [
                                    {
                                        "shell_command": "/Users/e/.config/karabiner/ua_mute_toggle.sh"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Volume Up -> UA Companion increase volume (or system volume)",
                                "from": { "consumer_key_code": "volume_increment" },
                                "to": [
                                    {
                                        "shell_command": "/Users/e/.config/karabiner/ua_volume.sh up"
                                    }
                                ],
                                "type": "basic"
                            },
                            {
                                "description": "Volume Down -> UA Companion decrease volume (or system volume)",
                                "from": { "consumer_key_code": "volume_decrement" },
                                "to": [
                                    {
                                        "shell_command": "/Users/e/.config/karabiner/ua_volume.sh down"
                                    }
                                ],
                                "type": "basic"
                            }
                        ]
                    },
                    {
